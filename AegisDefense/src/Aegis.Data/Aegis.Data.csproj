<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLite-backed local storage for events, alerts, policy, vulnerabilities, decoys and
    pending approvals. SQLite (not a client/server DB) is deliberate: the sensor/service
    must run unattended on isolated endpoints and small servers with zero external
    dependencies, from Windows 7 SP1 through Server 2025 (doc §19/§20 "local cache").
  -->

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Aegis.Data</RootNamespace>
    <AssemblyName>Aegis.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegis.Core\Aegis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
