<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="AegisDefenseConsole"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          The control pipe's ACL (see Aegis.Service/PipeServerFactory.cs) only grants access
          to BUILTIN\Administrators and LocalSystem. Under UAC, a standard filtered admin
          token does NOT satisfy that check - the console must run elevated to manage alerts,
          approve high-impact actions, and push signed policy changes.
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
