<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows Service host: wires Aegis.Sensor (collectors) -> Aegis.Core (rules/scoring/
    graph/state/policy) -> Aegis.Data (SQLite) -> Aegis.ResponseActions (containment), and
    exposes Aegis.Ipc's named pipe to Aegis.Gui. net48 for the same "old + new Windows +
    Server" reason as the other Windows-only projects.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Aegis.Service</RootNamespace>
    <AssemblyName>AegisDefenseService</AssemblyName>
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Explicit x64 (not AnyCPU) is required for Microsoft.Data.Sqlite's native dependency
      (SQLitePCLRaw/e_sqlite3.dll) to resolve correctly on classic .NET Framework: unlike
      .NET Core/8, net48 has no runtime RID-based native-asset probing, so SQLitePCLRaw's
      own build-time .targets file needs PlatformTarget to be unambiguous to copy the right
      native binary next to the exe. Left as AnyCPU, this throws "Library e_sqlite3 not
      found" / "%1 is not a valid Win32 application" at first DB open - confirmed against a
      real Windows run, not theoretical. x64 matches every other Windows target in this repo
      (installer/build-installer.ps1 publishes -r win-x64); 32-bit-only hosts are out of
      scope (Windows Server has been x64-only since 2008 R2).
    -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegis.Core\Aegis.Core.csproj" />
    <ProjectReference Include="..\Aegis.Data\Aegis.Data.csproj" />
    <ProjectReference Include="..\Aegis.Ipc\Aegis.Ipc.csproj" />
    <ProjectReference Include="..\Aegis.Sensor\Aegis.Sensor.csproj" />
    <ProjectReference Include="..\Aegis.ResponseActions\Aegis.ResponseActions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <!-- System.Security.Cryptography.ProtectedData (DPAPI) for EventChainKeyStore. -->
    <Reference Include="System.Security" />
    <!-- HttpClient for HttpFleetClient (v2 Fleet Hub reporting). -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildRuntimeType)' == 'Core' AND !$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
